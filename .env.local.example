# Same Supabase project as the main dogedin site. Only the anon key — this app
# reads exclusively from public views and SECURITY DEFINER aggregate functions,
# so there is nothing here an ordinary site visitor couldn't already see.
# Leave blank to run on built-in sample data (handy for design work).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute URL of the main site, used for outbound links. Defaults to
# https://dogedin.com when unset.
NEXT_PUBLIC_SITE_URL=
